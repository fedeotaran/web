<header>
  <nav>
    <ul>
      <li>
        <a href="/"><strong><%= @site_title %></strong></a>
      </li>
    </ul>
    <ul>
      <%= for section <- @pages do %>
        <li><a href="<%= section.url %>"><%= section.title %></a></li>
      <% end %>
      <%= if @blog.enabled do %>
        <li><a href="<%= @blog.url %>"><%= @blog.title %></a></li>
      <% end %>
      <li>
        <button
          id="theme-toggle"
          aria-label="Toggle theme"
          style="
            background:none;
            border:none;
            cursor:pointer;
            padding:0;
            box-shadow:none;
            outline:none;
            --pico-box-shadow: none;
          "
        >
          <span id="theme-icon" style="display:inline-block;">
            <svg width="24" height="24" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5" fill="orange"/><g stroke="orange" stroke-width="2"><line x1="12" y1="1" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="6.34" y2="6.34"/><line x1="17.66" y1="17.66" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="6.34" y2="17.66"/><line x1="17.66" y1="6.34" x2="19.78" y2="4.22"/></g></svg>
          </span>
        </button>
      </li>
    </ul>
  </nav>
</header>

<main>
  <article>
    <header>
      <hgroup>
        <h1><%= @title %></h1>
      </hgroup>
    </header>

    <section>
      <%= @inner_body %>
    </section>
  </article>
</main>

<footer>
  <p>
    <small>
      © <%= DateTime.utc_now().year %> |
      <a href="/feed.xml">RSS</a><%= if @social.email do %> | <a href="mailto:<%= @social.email %>">Email</a><% end %><%= if @social.github do %> | <a href="https://github.com/<%= @social.github %>">GitHub</a><% end %><%= if @social.twitter do %> | <a href="https://x.com/<%= @social.twitter %>">X</a><% end %><%= if @social.linkedin do %> | <a href="https://www.linkedin.com/in/<%= @social.linkedin %>">LinkedIn</a><% end %><%= if @social.bluesky do %> | <a href="https://bsky.app/profile/<%= @social.bluesky %>">Bluesky</a><% end %>
    </small>
  </p>
</footer>
